<Project>
  <Import Project="eng\Tests.targets" />

  <ItemGroup Condition="'$(EnableStyleCopAnalyzers)' != 'false'">
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableVisualStudioThreading)' != 'false'">
    <PackageReference Include="Microsoft.VisualStudio.Threading" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!--
    The GDI+ types (System.Drawing: the colors and fonts of the settings, the images of the resources), which WinForms
    brought before it was removed (docs/avalonia-port/PLAN.md, phase 8). The Avalonia projects have their own types of
    these names, hence no implicit using there.
  -->
  <ItemGroup Condition="'$(UseSystemDrawing)' != 'false'">
    <PackageReference Include="System.Drawing.Common" />
    <Using Include="System.Drawing" Condition="'$(ImplicitUsings)' == 'enable'" />

    <!-- The images of the .resx files are read from their preserialized form. -->
    <PackageReference Include="System.Resources.Extensions" />
  </ItemGroup>

  <PropertyGroup Condition="'$(UseSystemDrawing)' != 'false'">
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stop transitive consumption of JetBrains annotations -->
    <PackageReference Update="JetBrains.Annotations" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Avalonia port (docs/avalonia-port/PLAN.md): projects that only reach Avalonia transitively (e.g. through GitUI)
    receive its analyzers and XAML source generator, which fail without Avalonia's build props. Only projects that
    reference Avalonia directly (and therefore import its props) keep them.
  -->
  <Target Name="RemoveTransitiveAvaloniaAnalyzers" BeforeTargets="CoreCompile" Condition="'$(AvaloniaNameGeneratorIsEnabled)' == ''">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Analyzer.Filename)').StartsWith('Avalonia.'))" />
    </ItemGroup>
  </Target>

  <!--
    The build report tab of the Avalonia main window (docs/avalonia-port/PLAN.md, phase 8) only uses the Core API of
    WebView2 (Microsoft.Web.WebView2.Core.dll and the native WebView2Loader.dll): its WinForms and WPF controls, which
    the package references for every project that reaches it, are neither referenced nor shipped.
  -->
  <Target Name="RemoveUnusedWebView2References" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.WinForms' Or '%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>

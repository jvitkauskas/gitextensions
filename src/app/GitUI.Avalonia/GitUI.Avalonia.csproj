<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Avalonia views, controls and the WinForms/Avalonia hosting bridge (docs/avalonia-port/PLAN.md).
    Deliberately WinForms-free: interop with WinForms happens through native window handles only.
  -->
  <PropertyGroup>
    <UseWindowsForms>false</UseWindowsForms>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Win32" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitUI.Presentation\GitUI.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the WinForms UI rather than copied, so upstream asset updates apply to both. -->
    <AvaloniaResource Include="..\..\..\setup\assets\Logo\git-extensions-logo-256px.png" Link="Assets\git-extensions-logo-256px.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\Donate.png" Link="Assets\Donate.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\CopyToClipboard.png" Link="Assets\CopyToClipboard.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\StatusBadgeWaiting.png" Link="Assets\StatusBadgeWaiting.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\StatusBadgeSuccess.png" Link="Assets\StatusBadgeSuccess.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\StatusBadgeError.png" Link="Assets\StatusBadgeError.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\EyeClosed.png" Link="Assets\EyeClosed.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\EyeOpened.png" Link="Assets\EyeOpened.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\pageant.png" Link="Assets\Pageant.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\putty.png" Link="Assets\Putty.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\Preview.png" Link="Assets\Preview.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\CleanupRepo.png" Link="Assets\CleanupRepo.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\FolderSubmodule.png" Link="Assets\FolderSubmodule.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\ReloadRevisions.png" Link="Assets\ReloadRevisions.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\RepoOpen.png" Link="Assets\RepoOpen.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\BrowseFileExplorer.png" Link="Assets\BrowseFileExplorer.png" />
    <AvaloniaResource Include="..\GitUI\Resources\Icons\NavigateUp.png" Link="Assets\NavigateUp.png" />
  </ItemGroup>
</Project>

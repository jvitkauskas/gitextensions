<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                x:Class="GitUI.Avalonia.CommandsDialogs.CommandlineHelpWindow"
                x:DataType="vm:CommandlineHelpViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="394" Height="662" MinWidth="394" MinHeight="400">
  <ScrollViewer>
    <StackPanel>
      <TextBlock Text="{Binding Strings.Intro.Text}" TextWrapping="Wrap" Margin="10" />
      <SelectableTextBlock Name="commandsText" Text="{Binding Commands}" TextWrapping="Wrap" Margin="10,0,10,10" />
    </StackPanel>
  </ScrollViewer>
</h:DialogWindow>

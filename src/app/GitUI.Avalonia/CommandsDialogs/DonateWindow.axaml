<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                x:Class="GitUI.Avalonia.CommandsDialogs.DonateWindow"
                x:DataType="vm:DonateViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="508" SizeToContent="Height" CanResize="False">
  <StackPanel Margin="26" Spacing="24">
    <TextBlock Text="{Binding Strings.Text.Text}" TextWrapping="Wrap" />
    <Button Name="donateButton" Classes="link" HorizontalAlignment="Center"
            Command="{Binding DonateCommand}" AutomationProperties.Name="Donate">
      <Image Source="avares://GitUI.Avalonia/Assets/Donate.png" Height="56" />
    </Button>
  </StackPanel>
</h:DialogWindow>

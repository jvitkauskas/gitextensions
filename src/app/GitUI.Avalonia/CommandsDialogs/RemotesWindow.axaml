<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:git="using:GitExtensions.Extensibility.Git"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                x:Class="GitUI.Avalonia.CommandsDialogs.RemotesWindow"
                x:DataType="vm:RemotesViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="960" Height="560" MinWidth="900" MinHeight="420">
  <Window.Styles>
    <Style Selector="TextBlock.disabledRemote">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlDisabledBaseMediumLowBrush}" />
    </Style>
    <Style Selector="Border.groupBox">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
  </Window.Styles>
  <TabControl Name="tabControl" Margin="6" SelectedIndex="{Binding SelectedTabIndex}">
    <TabItem Header="{Binding Strings.RemotesTab.Text}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" Margin="0,6,0,0">
        <!-- Equivalent of panel1: the remotes list with the New/Delete/Toggle buttons in a column to its right (panelButtons, TopDown) -->
        <DockPanel Width="260">
          <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Spacing="6" Margin="6,0,0,0" VerticalAlignment="Top">
            <Button Name="newButton" Padding="4" ToolTip.Tip="{Binding Strings.NewTooltip.Text}" Command="{Binding NewCommand}">
              <Image Source="avares://GitUI.Avalonia/Assets/RemoteAdd.png" Width="16" Height="16" />
            </Button>
            <Button Name="deleteButton" Padding="4" ToolTip.Tip="{Binding Strings.DeleteTooltip.Text}" Command="{Binding DeleteCommand}">
              <Image Source="avares://GitUI.Avalonia/Assets/RemoteDelete.png" Width="16" Height="16" />
            </Button>
            <Button Name="toggleStateButton" Padding="4" ToolTip.Tip="{Binding ToggleStateTooltip}" Command="{Binding ToggleStateCommand}">
              <Panel>
                <Image h:ImageLightness.Adapt="True" Source="avares://GitUI.Avalonia/Assets/EyeOpened.png" Width="16" Height="16" IsVisible="{Binding IsSelectedDisabled}" />
                <Image h:ImageLightness.Adapt="True" Source="avares://GitUI.Avalonia/Assets/EyeClosed.png" Width="16" Height="16" IsVisible="{Binding !IsSelectedDisabled}" />
              </Panel>
            </Button>
          </StackPanel>
          <ListBox Name="remotesListBox" ItemsSource="{Binding Remotes}" SelectedItem="{Binding SelectedRemote}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RemoteListItem">
                <StackPanel>
                  <!-- Equivalent of the ListViewGroup headers -->
                  <TextBlock Text="{Binding GroupHeader}" FontWeight="SemiBold" Margin="0,0,0,2"
                             IsVisible="{Binding GroupHeader, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Text="{Binding Name}" Margin="8,0,0,0" Classes.disabledRemote="{Binding IsDisabled}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Equivalent of gbMgtPanel: docked to the top and sized to its content -->
        <Border Grid.Column="1" Classes="groupBox" VerticalAlignment="Top">
          <StackPanel Spacing="6" Grid.IsSharedSizeScope="True">
            <TextBlock Text="{Binding ManagementHeader}" FontWeight="SemiBold" />
            <StackPanel Spacing="6" IsEnabled="{Binding IsManagementEnabled}">
              <!-- Equivalent of pnlMgtDetails; the label column is as wide as the PuTTY "Private key file" one -->
              <Grid Classes="form" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6" Margin="8,0,8,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="label" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="browse" />
                </Grid.ColumnDefinitions>
                <Label Content="{Binding UrlLabel}" Target="urlComboBox" />
                <ComboBox Name="urlComboBox" Grid.Column="1" HorizontalAlignment="Stretch" IsEditable="True"
                          ItemsSource="{Binding UrlSuggestions}" Text="{Binding Url}" />
                <!-- Equivalent of the FolderBrowserButton -->
                <Button Name="browseUrlButton" Grid.Column="2" MinWidth="104" Command="{Binding BrowseUrlCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Image Source="avares://GitUI.Avalonia/Assets/BrowseFileExplorer.png" Width="16" Height="16" />
                    <AccessText Text="{Binding Strings.BrowseUrl.AccessKeyText}" />
                  </StackPanel>
                </Button>

                <Label Grid.Row="1" Content="{Binding Strings.Name.AccessKeyText}" Target="nameTextBox" />
                <TextBox Name="nameTextBox" Grid.Row="1" Grid.Column="1" Text="{Binding RemoteName}" />

                <Label Grid.Row="2" Content="{Binding Strings.Prefix.Text}" Target="prefixTextBox" IsVisible="{Binding ShowAdvancedOptions}" />
                <TextBox Name="prefixTextBox" Grid.Row="2" Grid.Column="1" Text="{Binding Prefix}" IsVisible="{Binding ShowAdvancedOptions}" />

                <Label Grid.Row="3" Content="{Binding Strings.Color.Text}" IsVisible="{Binding ShowAdvancedOptions}" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowAdvancedOptions}">
                  <Button Name="colorButton" MinWidth="60" Command="{Binding PickColorCommand}">
                    <Panel>
                      <AccessText Text="{Binding Strings.SetColor.AccessKeyText}" IsVisible="{Binding !HasColor}" />
                      <Border Name="colorSwatch" Width="40" Height="14" IsVisible="{Binding HasColor}" />
                    </Panel>
                  </Button>
                  <Button Name="resetColorButton" Content="{Binding Strings.DefaultColor.Text}" Command="{Binding ResetColorCommand}" IsVisible="{Binding HasColor}" />
                </StackPanel>

                <CheckBox Name="separatePushUrlCheckBox" Grid.Row="4" Grid.ColumnSpan="2" Margin="24,0,0,0"
                          Content="{Binding Strings.SeparatePushUrl.AccessKeyText}" IsChecked="{Binding IsSeparatePushUrl}" />

                <Label Grid.Row="5" Content="{Binding Strings.PushUrl.AccessKeyText}" Target="pushUrlComboBox" IsVisible="{Binding IsSeparatePushUrl}" />
                <ComboBox Name="pushUrlComboBox" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" IsEditable="True"
                          ItemsSource="{Binding PushUrlSuggestions}" Text="{Binding PushUrl}" IsVisible="{Binding IsSeparatePushUrl}" />
                <Button Name="browsePushUrlButton" Grid.Row="5" Grid.Column="2" MinWidth="104"
                        Command="{Binding BrowsePushUrlCommand}" IsVisible="{Binding IsSeparatePushUrl}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Image Source="avares://GitUI.Avalonia/Assets/BrowseFileExplorer.png" Width="16" Height="16" />
                    <AccessText Text="{Binding Strings.BrowsePushUrl.AccessKeyText}" />
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Equivalent of pnlMgtPuttySsh: a header label followed by a separator line (lblHeaderLine2) -->
              <StackPanel Spacing="6" Margin="0,0,0,8" IsVisible="{Binding IsPuttyEnabled}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <TextBlock Text="{Binding Strings.PuttySsh.Text}" />
                  <Separator Grid.Column="1" VerticalAlignment="Center" Margin="0" />
                </Grid>
                <Grid Classes="form" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6" Margin="8,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="label" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="browse" />
                  </Grid.ColumnDefinitions>
                  <Label Content="{Binding Strings.PrivateKeyFile.AccessKeyText}" Target="sshKeyTextBox" />
                  <TextBox Name="sshKeyTextBox" Grid.Column="1" Text="{Binding PuttySshKey}" />
                  <Button Name="sshBrowseButton" Grid.Column="2" MinWidth="104" Command="{Binding BrowseSshKeyCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Image Source="avares://GitUI.Avalonia/Assets/FileNew.png" Width="16" Height="16" />
                      <AccessText Text="{Binding Strings.SshBrowse.AccessKeyText}" />
                    </StackPanel>
                  </Button>
                  <!-- Equivalent of flowLayoutPanelSsh (RightToLeft): Test connection rightmost, Load SSH key to its left -->
                  <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                    <Button Name="loadSshKeyButton" MinWidth="160" Command="{Binding LoadSshKeyCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="avares://GitUI.Avalonia/Assets/Putty.png" Width="16" Height="16" />
                        <AccessText Text="{Binding Strings.LoadSshKey.AccessKeyText}" />
                      </StackPanel>
                    </Button>
                    <Button Name="testConnectionButton" MinWidth="160" Command="{Binding TestConnectionCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="avares://GitUI.Avalonia/Assets/Putty.png" Width="16" Height="16" />
                        <AccessText Text="{Binding Strings.TestConnection.AccessKeyText}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>

            <!-- Equivalent of flowLayoutPanel2: Save changes right under the PuTTY section -->
            <Button Name="saveButton" HorizontalAlignment="Right" Margin="0,0,20,0" MinWidth="130" Classes="accent"
                    Command="{Binding SaveCommand}" IsEnabled="{Binding IsManagementEnabled}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Image Source="avares://GitUI.Avalonia/Assets/Save.png" Width="16" Height="16" />
                <AccessText Text="{Binding Strings.Save.AccessKeyText}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </TabItem>

    <TabItem Header="{Binding Strings.PullBehaviorTab.Text}">
      <DockPanel Margin="0,6,0,0">
        <!-- Equivalent of panelDetails: Save changes on its own row under "Default merge with", right-aligned -->
        <Grid DockPanel.Dock="Bottom" Classes="form" Margin="33,6,50,0" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnSpacing="14" RowSpacing="4" IsEnabled="{Binding IsHeadSelected}">
          <Label Content="{Binding Strings.LocalBranchName.AccessKeyText}" Target="localBranchTextBox" />
          <TextBox Name="localBranchTextBox" Grid.Column="1" IsReadOnly="True" Text="{Binding LocalBranchName, Mode=OneWay}" />
          <Label Grid.Row="1" Content="{Binding Strings.RemoteRepository.AccessKeyText}" Target="trackingRemoteComboBox" />
          <ComboBox Name="trackingRemoteComboBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding TrackingRemoteNames}" SelectedItem="{Binding SelectedTrackingRemote}" />
          <Label Grid.Row="2" Content="{Binding Strings.DefaultMergeWith.AccessKeyText}" Target="mergeWithComboBox" />
          <ComboBox Name="mergeWithComboBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" IsEditable="True"
                    ItemsSource="{Binding MergeWithCandidates}" Text="{Binding MergeWith}" />
          <Button Name="saveDefaultPushPullButton" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" MinWidth="130"
                  Command="{Binding SaveDefaultPushPullCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Source="avares://GitUI.Avalonia/Assets/Save.png" Width="16" Height="16" />
              <AccessText Text="{Binding Strings.SaveDefaultPushPull.AccessKeyText}" />
            </StackPanel>
          </Button>
        </Grid>
        <DataGrid Name="headsGrid" ItemsSource="{Binding Heads}" SelectedItem="{Binding SelectedHead}"
                  IsReadOnly="True" SelectionMode="Single" CanUserReorderColumns="False"
                  HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="1"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding LocalName}" Width="*" x:DataType="git:IGitRef" />
            <DataGridTextColumn Binding="{Binding TrackingRemote}" Width="*" x:DataType="git:IGitRef" />
            <DataGridTextColumn Binding="{Binding MergeWith}" Width="*" x:DataType="git:IGitRef" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </TabItem>
  </TabControl>
</h:DialogWindow>

<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:ed="using:GitUI.Avalonia.Editor"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                x:Class="GitUI.Avalonia.CommandsDialogs.FileEditorWindow"
                x:DataType="vm:FileEditorViewModel"
                Title="{Binding Title}"
                Width="659" Height="543" MinWidth="400" MinHeight="250">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>
  <DockPanel>
    <!-- Equivalent of the tool strip -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2">
      <Button Name="saveButton" Padding="4" Classes="link" ToolTip.Tip="{Binding Strings.Save.Text}" Command="{Binding SaveCommand}">
        <Image Source="avares://GitUI.Avalonia/Assets/Save.png" Width="16" Height="16" />
      </Button>
    </StackPanel>
    <!-- Equivalent of panelMessage: the warning for files that are harmful to edit by hand. -->
    <Border Name="warningPanel" DockPanel.Dock="Top" Background="#E66363" Padding="8,6" IsVisible="{Binding ShowWarning}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Image Source="avares://GitUI.Avalonia/Assets/Warning.png" Width="16" Height="16" VerticalAlignment="Top" />
        <TextBlock Text="{Binding Strings.Warning.Text}" TextWrapping="Wrap" Foreground="Black" />
      </StackPanel>
    </Border>
    <Panel>
      <ed:TextEditorView Name="editorView" DataContext="{Binding Editor}" />
      <ed:EditorOptionsToolbar Name="optionsToolbar" DataContext="{Binding Options}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </Panel>
  </DockPanel>
</h:DialogWindow>

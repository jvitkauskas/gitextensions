<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:c="using:GitUI.Avalonia.Controls"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                x:Class="GitUI.Avalonia.CommandsDialogs.CompareToBranchWindow"
                x:DataType="vm:CompareToBranchViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="460" MinWidth="380" SizeToContent="Height" CanMaximize="False" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <Button Name="compareButton" HorizontalAlignment="Right" Classes="accent" IsDefault="True"
              Content="{Binding Strings.Compare.AccessKeyText}" Command="{Binding CompareCommand}" />
    </Border>
    <c:LocalRemoteBranchSelectorView Name="branchSelector" Margin="12" DataContext="{Binding BranchSelector}" />
  </DockPanel>
</h:DialogWindow>

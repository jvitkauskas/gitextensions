<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs.BrowseDialog"
                x:Class="GitUI.Avalonia.CommandsDialogs.BrowseDialog.UpdatesWindow"
                x:DataType="vm:UpdatesViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="462" SizeToContent="Height" CanResize="False">
  <StackPanel Margin="9" Spacing="6">
    <TextBlock Name="statusText" Text="{Binding Status}" TextWrapping="Wrap" />
    <ProgressBar Name="progressBar" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

    <!-- Equivalent of the SettingsLinkLabel: the version is the link, the icon opens the help. -->
    <StackPanel Name="requiredRuntimePanel" Orientation="Horizontal" Spacing="4"
                IsVisible="{Binding RequiredRuntimeText, Converter={x:Static ObjectConverters.IsNotNull}}"
                ToolTip.Tip="{Binding Strings.RequiredRuntimeToolTip.Text}">
      <!-- A row rather than an InlineUIContainer, which Avalonia re-measures during rendering. -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock VerticalAlignment="Center" Text="{Binding RequiredRuntimeText.Before, FallbackValue=''}" />
        <Button Name="runtimeDownloadLink" Classes="link" VerticalAlignment="Center" Command="{Binding OpenRuntimeDownloadCommand}">
          <TextBlock Text="{Binding RequiredRuntimeText.Link, FallbackValue=''}" />
        </Button>
        <TextBlock VerticalAlignment="Center" Text="{Binding RequiredRuntimeText.After, FallbackValue=''}" />
      </StackPanel>
      <Button Name="runtimeHelpButton" Classes="link" VerticalAlignment="Center" Command="{Binding OpenRuntimeHelpCommand}">
        <Image Source="avares://GitUI.Avalonia/Assets/Information.png" Width="16" Height="16" />
      </Button>
    </StackPanel>

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4" VerticalAlignment="Center">
        <Button Name="changeLogLink" Classes="link" IsVisible="{Binding IsChangeLogVisible}" Command="{Binding OpenChangeLogCommand}">
          <AccessText Text="{Binding Strings.ChangeLog.AccessKeyText}" />
        </Button>
        <Button Name="directDownloadLink" Classes="link" IsVisible="{Binding IsUpdateFound}" Command="{Binding DirectDownloadCommand}">
          <AccessText Text="{Binding Strings.DirectDownload.AccessKeyText}" />
        </Button>
      </StackPanel>
      <Button Name="updateNowButton" Grid.Column="1" VerticalAlignment="Bottom" Classes="accent"
              IsVisible="{Binding CanUpdateNow}" Content="{Binding Strings.UpdateNow.AccessKeyText}" Command="{Binding UpdateNowCommand}" />
    </Grid>
  </StackPanel>
</h:DialogWindow>

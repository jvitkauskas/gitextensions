<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:ed="using:GitUI.Avalonia.Editor"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs.BrowseDialog"
                x:Class="GitUI.Avalonia.CommandsDialogs.BrowseDialog.ChangeLogWindow"
                x:DataType="vm:ChangeLogViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="849" Height="411" MinWidth="400" MinHeight="250">
  <ed:TextEditorView Name="changeLogView" DataContext="{Binding ChangeLog}" />
</h:DialogWindow>

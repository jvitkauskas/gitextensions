<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:c="using:GitUI.Avalonia.Controls"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                x:Class="GitUI.Avalonia.CommandsDialogs.CreateBranchWindow"
                x:DataType="vm:CreateBranchViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="520" MinWidth="480" SizeToContent="Height" CanMaximize="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <Button Name="createButton" HorizontalAlignment="Right" Classes="accent" IsDefault="True" Command="{Binding CreateCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Image Source="avares://GitUI.Avalonia/Assets/BranchCreate.png" Width="16" Height="16" />
          <AccessText Text="{Binding Strings.CreateBranch.AccessKeyText}" />
        </StackPanel>
      </Button>
    </Border>
    <StackPanel Margin="9" Spacing="8">
      <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
        <Label Content="{Binding Strings.BranchName.AccessKeyText}" Target="branchNameTextBox" />
        <TextBox Name="branchNameTextBox" Grid.Column="1" Text="{Binding BranchName}" LostFocus="BranchNameTextBox_LostFocus" />
        <Label Grid.Row="1" Content="{Binding CreateBranchCaption}" Target="commitPicker" />
        <Panel Grid.Row="1" Grid.Column="1" IsVisible="{Binding !IsOrphanOnly}">
          <c:CommitPickerView Name="commitPicker" DataContext="{Binding CommitPicker}" />
        </Panel>
      </Grid>
      <Panel IsVisible="{Binding !IsOrphanOnly}">
        <c:CommitSummaryView Name="commitSummary" DataContext="{Binding Summary}" />
      </Panel>
      <CheckBox Name="checkoutCheckBox" Content="{Binding Strings.CheckoutAfterCreate.AccessKeyText}"
                IsChecked="{Binding CheckoutAfterCreate}" IsEnabled="{Binding CanChangeCheckout}" />
      <!-- Equivalent of the "Orphan" group box -->
      <Border BorderThickness="1" CornerRadius="4" Padding="12,8" IsEnabled="{Binding CanCreateOrphan}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Strings.Orphan.Text}" FontWeight="SemiBold" />
          <CheckBox Name="createOrphanCheckBox" Content="{Binding Strings.CreateOrphan.AccessKeyText}"
                    ToolTip.Tip="{Binding Strings.CreateOrphanTooltip.Text}"
                    IsChecked="{Binding CreateOrphan}" IsEnabled="{Binding CanChangeCreateOrphan}" />
          <CheckBox Name="clearOrphanCheckBox" Content="{Binding Strings.ClearOrphan.AccessKeyText}"
                    ToolTip.Tip="{Binding Strings.ClearOrphanTooltip.Text}"
                    IsChecked="{Binding ClearOrphan}" IsEnabled="{Binding CanChangeClearOrphan}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </DockPanel>
</h:DialogWindow>

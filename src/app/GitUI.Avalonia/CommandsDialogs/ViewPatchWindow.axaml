<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:ed="using:GitUI.Avalonia.Editor"
                xmlns:git="using:GitExtensions.Extensibility.Git"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                x:Class="GitUI.Avalonia.CommandsDialogs.ViewPatchWindow"
                x:DataType="vm:ViewPatchViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="900" Height="620" MinWidth="500" MinHeight="350">
  <DockPanel Margin="6">
    <Grid DockPanel.Dock="Top" Classes="form" Margin="0,0,0,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <Label Content="{Binding Strings.Patch.AccessKeyText}" Target="patchFileTextBox" />
      <TextBox Name="patchFileTextBox" Grid.Column="1" Text="{Binding PatchFile}" />
      <Button Name="browseButton" Grid.Column="2" MinWidth="80" Content="{Binding Strings.Browse.AccessKeyText}" Command="{Binding BrowseCommand}" />
    </Grid>
    <Grid RowDefinitions="160,Auto,*">
      <DataGrid Name="patchesGrid" ItemsSource="{Binding Patches}" SelectedItem="{Binding SelectedPatch}"
                IsReadOnly="True" SelectionMode="Single" CanUserReorderColumns="False"
                HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding ChangeType}" Width="90" x:DataType="git:Patch" />
          <DataGridTextColumn Binding="{Binding FileType}" Width="70" x:DataType="git:Patch" />
          <DataGridTextColumn Binding="{Binding FileNameA}" Width="*" x:DataType="git:Patch" />
        </DataGrid.Columns>
      </DataGrid>
      <GridSplitter Grid.Row="1" Height="5" ResizeDirection="Rows" Background="Transparent" />
      <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <ed:TextEditorView Name="diffView" DataContext="{Binding Diff}" />
      </Border>
    </Grid>
  </DockPanel>
</h:DialogWindow>

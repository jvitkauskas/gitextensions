<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                x:Class="GitUI.Avalonia.CommandsDialogs.InitWindow"
                x:DataType="vm:InitViewModel"
                Title="{Binding Strings.Title.PlainText}"
                ManualSectionSubfolder="getting_started" ManualSectionAnchorName="create-new-repository"
                Width="542" MinWidth="450" SizeToContent="Height" CanMaximize="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <Button Name="createButton" HorizontalAlignment="Right" Classes="accent" IsDefault="True"
              Content="{Binding Strings.Create.AccessKeyText}" Command="{Binding CreateCommand}" />
    </Border>
    <StackPanel Margin="9" Spacing="8">
      <Grid Classes="form" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Label Content="{Binding Strings.Directory.AccessKeyText}" Target="directoryComboBox" />
        <ComboBox Name="directoryComboBox" Grid.Column="1" HorizontalAlignment="Stretch" IsEditable="True"
                  ItemsSource="{Binding RecentDirectories}" Text="{Binding Directory}" />
        <Button Name="browseButton" Grid.Column="2" MinWidth="100" Command="{Binding BrowseCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Source="avares://GitUI.Avalonia/Assets/BrowseFileExplorer.png" Width="16" Height="16" />
            <AccessText Text="{Binding Strings.Browse.AccessKeyText}" />
          </StackPanel>
        </Button>
      </Grid>
      <!-- Equivalent of the "Repository type" group box -->
      <Border BorderThickness="1" CornerRadius="4" Padding="12,8"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Strings.RepositoryType.Text}" FontWeight="SemiBold" />
          <RadioButton Name="personalRadioButton" GroupName="repositoryType"
                       Content="{Binding Strings.Personal.AccessKeyText}" IsChecked="{Binding !IsCentral, Mode=OneWay}" />
          <RadioButton Name="centralRadioButton" GroupName="repositoryType"
                       Content="{Binding Strings.Central.AccessKeyText}" IsChecked="{Binding IsCentral}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </DockPanel>
</h:DialogWindow>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitUI.Presentation.CommandsDialogs.SettingsDialog.Pages"
             x:Class="GitUI.Avalonia.CommandsDialogs.SettingsDialog.Pages.CommitDialogSettingsPageView"
             x:DataType="vm:CommitDialogSettingsPageViewModel">
  <!-- Equivalent of CommitDialogSettingsPage: groupBoxBehaviour, then grpAdditionalButtons. -->
  <StackPanel>
    <HeaderedContentControl Classes="groupBox" Header="{Binding Strings.Behaviour.Text}">
      <StackPanel Spacing="4">
        <CheckBox Name="showErrorsWhenStagingFiles" Content="{Binding Strings.ShowErrorsWhenStagingFiles.AccessKeyText}" IsChecked="{Binding ShowErrorsWhenStagingFiles}" />
        <CheckBox Name="ensureCommitMessageSecondLineEmpty" Content="{Binding Strings.EnsureCommitMessageSecondLineEmpty.AccessKeyText}" IsChecked="{Binding EnsureCommitMessageSecondLineEmpty}" />
        <CheckBox Name="writeCommitMessageInCommitWindow" IsChecked="{Binding WriteCommitMessageInCommitWindow}">
          <TextBlock Text="{Binding Strings.WriteCommitMessageInCommitWindow.PlainText}" TextWrapping="Wrap" />
        </CheckBox>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding Strings.NumberOfPreviousMessages.PlainText}" VerticalAlignment="Center" />
          <NumericUpDown Name="numberOfPreviousMessages" Width="120" Minimum="1" Maximum="999" Increment="1" FormatString="0"
                         Value="{Binding NumberOfPreviousMessages}" />
        </StackPanel>
        <CheckBox Name="autocomplete" Content="{Binding Strings.Autocomplete.AccessKeyText}" IsChecked="{Binding Autocomplete}" />
        <CheckBox Name="rememberAmendCommitState" Content="{Binding Strings.RememberAmendCommitState.AccessKeyText}" IsChecked="{Binding RememberAmendCommitState}" />
      </StackPanel>
    </HeaderedContentControl>
    <HeaderedContentControl Classes="groupBox" Header="{Binding Strings.AdditionalButtons.Text}">
      <StackPanel Spacing="4">
        <CheckBox Name="showCommitAndPush" Content="{Binding Strings.ShowCommitAndPush.AccessKeyText}" IsChecked="{Binding ShowCommitAndPush}" />
        <CheckBox Name="showResetWorkTreeChanges" Content="{Binding Strings.ShowResetWorkTreeChanges.AccessKeyText}" IsChecked="{Binding ShowResetWorkTreeChanges}" />
        <CheckBox Name="showResetAllChanges" Content="{Binding Strings.ShowResetAllChanges.AccessKeyText}" IsChecked="{Binding ShowResetAllChanges}" />
      </StackPanel>
    </HeaderedContentControl>
  </StackPanel>
</UserControl>

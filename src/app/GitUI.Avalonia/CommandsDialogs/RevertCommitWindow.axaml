<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:c="using:GitUI.Avalonia.Controls"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                x:Class="GitUI.Avalonia.CommandsDialogs.RevertCommitWindow"
                x:DataType="vm:RevertCommitViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="600" MinWidth="560" SizeToContent="Height" CanMaximize="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <Button Name="revertButton" Classes="accent" IsDefault="True"
                Content="{Binding Strings.Revert.AccessKeyText}" Command="{Binding RevertCommand}" />
        <Button Name="abortButton" IsCancel="True"
                Content="{Binding Strings.Abort.AccessKeyText}" Command="{Binding AbortCommand}" />
      </StackPanel>
    </Border>
    <StackPanel Margin="9" Spacing="8">
      <TextBlock Text="{Binding Strings.RevertThisCommit.Text}" />
      <c:CommitSummaryView Name="commitSummary" DataContext="{Binding Summary}" />
      <c:MergeParentsView Name="mergeParents" />
      <CheckBox Name="autoCommitCheckBox" Content="{Binding Strings.AutoCommit.AccessKeyText}" IsChecked="{Binding AutoCommit}" />
    </StackPanel>
  </DockPanel>
</h:DialogWindow>

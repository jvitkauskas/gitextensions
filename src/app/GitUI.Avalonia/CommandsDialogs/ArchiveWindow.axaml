<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:c="using:GitUI.Avalonia.Controls"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                x:Class="GitUI.Avalonia.CommandsDialogs.ArchiveWindow"
                x:DataType="vm:ArchiveViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="620" MinWidth="610" SizeToContent="Height" CanMaximize="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <!-- Equivalent of the "Archive format" group box (the format names are not translated). -->
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding Strings.ArchiveFormat.Text}" VerticalAlignment="Center" />
          <RadioButton Name="zipRadioButton" GroupName="archiveFormat" Content="zip" IsChecked="{Binding IsZip}" />
          <RadioButton Name="tarRadioButton" GroupName="archiveFormat" Content="tar" IsChecked="{Binding IsTar}" />
        </StackPanel>
        <Button Name="saveButton" Grid.Column="2" Classes="accent" IsDefault="True" Command="{Binding SaveCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Source="avares://GitUI.Avalonia/Assets/SaveAs.png" Width="16" Height="16" />
            <AccessText Text="{Binding Strings.SaveAs.AccessKeyText}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <StackPanel Margin="9" Spacing="8">
      <TextBlock Text="{Binding Strings.RevisionToArchive.Text}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <c:CommitSummaryView Name="commitSummary" DataContext="{Binding Summary}" />
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top" Width="112">
          <TextBlock Text="{Binding Strings.ChooseAnotherRevision.Text}" TextWrapping="Wrap" />
          <Button Name="chooseRevisionButton" Padding="4" Command="{Binding ChooseRevisionCommand}">
            <Image Source="avares://GitUI.Avalonia/Assets/SelectRevision.png" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </Grid>
      <!-- Equivalent of the "Filter files" group box -->
      <Border BorderThickness="1" CornerRadius="4" Padding="12,8"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Strings.FilterFiles.Text}" FontWeight="SemiBold" />
          <CheckBox Name="pathFilterCheckBox" Content="{Binding Strings.PathFilter.AccessKeyText}" IsChecked="{Binding IsPathFilterEnabled}" />
          <TextBox Name="pathsTextBox" Height="75" Margin="18,0,0,0" AcceptsReturn="True" TextWrapping="NoWrap"
                   Text="{Binding Paths}" IsEnabled="{Binding IsPathFilterEnabled}" />
          <TextBlock Margin="18,0,0,0" Text="{Binding Strings.PathFilterHint.Text}"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
          <CheckBox Name="revisionFilterCheckBox" IsChecked="{Binding IsRevisionFilterEnabled}">
            <AccessText Text="{Binding Strings.RevisionFilter.AccessKeyText}" TextWrapping="Wrap" />
          </CheckBox>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="18,0,0,0" IsEnabled="{Binding IsRevisionFilterEnabled}">
            <c:CommitSummaryView Name="diffCommitSummary" DataContext="{Binding DiffSummary}" />
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top" Width="112">
              <TextBlock Text="{Binding Strings.ChooseDiffRevision.Text}" TextWrapping="Wrap" />
              <Button Name="chooseDiffRevisionButton" Padding="4" Command="{Binding ChooseDiffRevisionCommand}">
                <Image Source="avares://GitUI.Avalonia/Assets/SelectRevision.png" Width="16" Height="16" />
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </DockPanel>
</h:DialogWindow>

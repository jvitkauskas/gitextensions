<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:ed="using:GitUI.Avalonia.Editor"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                x:Class="GitUI.Avalonia.HelperDialogs.TextViewerWindow"
                x:DataType="vm:TextViewerViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="760" Height="560" MinWidth="300" MinHeight="200">
  <ed:TextEditorView Name="textView" DataContext="{Binding Editor}" />
</h:DialogWindow>

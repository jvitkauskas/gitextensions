<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:vm="using:GitUI.Presentation.HelperDialogs"
                x:Class="GitUI.Avalonia.HelperDialogs.SelectMultipleBranchesWindow"
                x:DataType="vm:SelectMultipleBranchesViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="300" Height="340" MinWidth="200" MinHeight="200">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <Button Name="okButton" HorizontalAlignment="Right" Classes="accent" IsDefault="True"
              Content="{Binding Strings.Ok.AccessKeyText}" Command="{Binding OkCommand}" />
    </Border>
    <DockPanel Margin="9">
      <Label DockPanel.Dock="Top" Padding="0,0,0,6" Content="{Binding Strings.SelectBranches.AccessKeyText}" Target="branchesListBox" />
      <!-- Equivalent of the CheckedListBox with CheckOnClick: clicking an item toggles its check box. -->
      <ListBox Name="branchesListBox" ItemsSource="{Binding Branches}" SelectionMode="Single">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CheckableItem">
            <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</h:DialogWindow>

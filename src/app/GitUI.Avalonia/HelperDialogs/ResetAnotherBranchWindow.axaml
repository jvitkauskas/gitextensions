<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:c="using:GitUI.Avalonia.Controls"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                x:Class="GitUI.Avalonia.HelperDialogs.ResetAnotherBranchWindow"
                x:DataType="vm:ResetAnotherBranchViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="540" MinWidth="500" SizeToContent="Height" CanMaximize="False">
  <Window.Styles>
    <!-- As FormResetAnotherBranch: an unknown branch and a non-fast-forward reset are highlighted. -->
    <Style Selector="ComboBox.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
    </Style>
    <Style Selector="AccessText.nonFastForward">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <Button Name="okButton" MinWidth="91" Classes="accent" IsDefault="True"
                Content="{Binding Strings.Ok.AccessKeyText}" Command="{Binding OkCommand}" />
        <Button Name="cancelButton" MinWidth="91" IsCancel="True"
                Content="{Binding Strings.Cancel.AccessKeyText}" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Border>
    <StackPanel Margin="9" Spacing="8">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <Image Source="avares://GitUI.Avalonia/Assets/Warning.png" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0" />
        <TextBlock Grid.Column="1" Text="{Binding Strings.Warning.Text}" TextWrapping="Wrap" />
      </Grid>
      <Label Content="{Binding Strings.ResetLocalBranch.AccessKeyText}" Target="branchesComboBox" Padding="0" />
      <ComboBox Name="branchesComboBox" HorizontalAlignment="Stretch" IsEditable="True"
                ItemsSource="{Binding Branches}" Text="{Binding Branch}"
                Classes.invalid="{Binding IsBranchInvalid}" />
      <c:CommitSummaryView Name="commitSummary" DataContext="{Binding Summary}" />
      <CheckBox Name="checkoutCheckBox" Content="{Binding Strings.CheckoutAfterReset.AccessKeyText}" IsChecked="{Binding CheckoutAfterReset}" />
      <CheckBox Name="forceCheckBox" IsChecked="{Binding ForceReset}">
        <AccessText Text="{Binding Strings.ForceReset.AccessKeyText}" Classes.nonFastForward="{Binding IsNonFastForward}" />
      </CheckBox>
    </StackPanel>
  </DockPanel>
</h:DialogWindow>

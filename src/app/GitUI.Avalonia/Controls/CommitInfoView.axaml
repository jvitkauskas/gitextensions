<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:GitUI.Avalonia.Controls"
             xmlns:vm="using:GitUI.Presentation.UserControls"
             x:Class="GitUI.Avalonia.Controls.CommitInfoView"
             x:DataType="vm:CommitInfoViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasRevision}">
    <StackPanel Spacing="8" Margin="6">
      <!-- Equivalent of CommitInfoHeader: the labels aligned as the tab stops of the RichTextBox. -->
      <ItemsControl Name="header" ItemsSource="{Binding Header}" Grid.IsSharedSizeScope="True">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CommitInfoHeaderLine">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Label}" Margin="0,0,12,0" />
              <c:XhtmlTextBlock Grid.Column="1" Xhtml="{Binding ValueXhtml}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- Equivalent of pnlCommitMessage: the message on a slightly darker background. -->
      <Border Name="messagePanel" Padding="6" CornerRadius="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <c:XhtmlTextBlock Name="message" Xhtml="{Binding Message}" />
      </Border>
      <c:XhtmlTextBlock Name="revisionInfo" Xhtml="{Binding RevisionInfo}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rg="using:GitUI.Avalonia.Controls.RevisionGrid"
             xmlns:vm="using:GitUI.Presentation.UserControls.RevisionGrid"
             xmlns:s="using:GitUI.Avalonia.CommandsDialogs.SettingsDialog"
             x:Class="GitUI.Avalonia.Controls.RevisionGrid.RevisionGridView"
             x:DataType="vm:RevisionGridViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <!-- The colors of the build statuses, as BuildStatusColumnProvider (lighter on dark backgrounds). -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BuildSuccessBrush" Color="DarkGreen" />
          <SolidColorBrush x:Key="BuildFailureBrush" Color="DarkRed" />
          <SolidColorBrush x:Key="BuildInProgressBrush" Color="Blue" />
          <SolidColorBrush x:Key="BuildUnstableBrush" Color="OrangeRed" />
          <SolidColorBrush x:Key="BuildStoppedBrush" Color="Gray" />
          <SolidColorBrush x:Key="NonRelativeTextBrush" Color="#6D6D6D" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BuildSuccessBrush" Color="LightGreen" />
          <SolidColorBrush x:Key="BuildFailureBrush" Color="#FF6060" />
          <SolidColorBrush x:Key="BuildInProgressBrush" Color="#82B4F0" />
          <SolidColorBrush x:Key="BuildUnstableBrush" Color="OrangeRed" />
          <SolidColorBrush x:Key="BuildStoppedBrush" Color="LightGray" />
          <SolidColorBrush x:Key="NonRelativeTextBrush" Color="#C0C0C0" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Reference "capsules" before the subject, colored as the WinForms revision grid's. -->
    <Style Selector="Border.ref">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="3,0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.ref TextBlock">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.ref.branch">
      <Setter Property="BorderBrush" Value="{DynamicResource AppColor.Branch}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AppColor.Branch}" />
    </Style>
    <Style Selector="Border.ref.remote">
      <Setter Property="BorderBrush" Value="{DynamicResource AppColor.RemoteBranch}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AppColor.RemoteBranch}" />
    </Style>
    <Style Selector="Border.ref.tag">
      <Setter Property="BorderBrush" Value="{DynamicResource AppColor.Tag}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AppColor.Tag}" />
    </Style>
    <!-- As the stash label of MessageColumnProvider (AppColor.OtherTag). -->
    <Style Selector="Border.ref.stash">
      <Setter Property="BorderBrush" Value="{DynamicResource AppColor.OtherTag}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AppColor.OtherTag}" />
    </Style>
    <!-- The hovered label, whose ancestry is highlighted in the graph (the highlight border of RevisionGridRefRenderer). -->
    <Style Selector="Border.ref.hoverable:pointerover">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.ref.current TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border#quickSearchLabel TextBlock">
      <Setter Property="Foreground" Value="Black" />
    </Style>
    <Style Selector="Border#quickSearchLabel TextBlock.noMatch">
      <Setter Property="Foreground" Value="DarkRed" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="MinHeight" Value="22" />
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>
    <!-- As RevisionDataGridView: the rows of the highlighted author, and the gray texts of the non-relatives. -->
    <Style Selector="DataGridRow.authored DataGridCell">
      <Setter Property="Background" Value="{DynamicResource AuthoredRowBrush}" />
    </Style>
    <Style Selector="DataGridRow.nonRelative TextBlock.cellText">
      <Setter Property="Foreground" Value="{DynamicResource NonRelativeTextBrush}" />
    </Style>
    <Style Selector="TextBlock.author.highlighted">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.buildStatus.Success">
      <Setter Property="Foreground" Value="{DynamicResource BuildSuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.buildStatus.Failure">
      <Setter Property="Foreground" Value="{DynamicResource BuildFailureBrush}" />
    </Style>
    <Style Selector="TextBlock.buildStatus.InProgress">
      <Setter Property="Foreground" Value="{DynamicResource BuildInProgressBrush}" />
    </Style>
    <Style Selector="TextBlock.buildStatus.Unstable">
      <Setter Property="Foreground" Value="{DynamicResource BuildUnstableBrush}" />
    </Style>
    <Style Selector="TextBlock.buildStatus.Stopped">
      <Setter Property="Foreground" Value="{DynamicResource BuildStoppedBrush}" />
    </Style>
    <Style Selector="StackPanel.buildReport">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <!-- The columns in the order of RevisionGridControl: graph, message, notes, avatar, author, date, id, build status. -->
    <DataGrid Name="revisionsGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
              IsReadOnly="True" SelectionMode="Single" CanUserSortColumns="False" CanUserReorderColumns="False"
              HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DataGrid.Columns>
        <DataGridTemplateColumn Width="64" CanUserResize="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:RevisionGridRow">
              <rg:RevisionGraphCell Graph="{Binding $parent[rg:RevisionGridView].Graph}"
                                    Renderer="{Binding $parent[rg:RevisionGridView].Renderer}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:RevisionGridRow">
              <StackPanel Orientation="Horizontal" Margin="4,0" ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding Refs}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RevisionRefItem">
                      <Border Classes="ref"
                              Classes.branch="{Binding Kind, Converter={x:Static rg:RevisionRefKindConverter.Branch}}"
                              Classes.remote="{Binding Kind, Converter={x:Static rg:RevisionRefKindConverter.RemoteBranch}}"
                              Classes.tag="{Binding Kind, Converter={x:Static rg:RevisionRefKindConverter.Tag}}"
                              Classes.stash="{Binding Kind, Converter={x:Static rg:RevisionRefKindConverter.Stash}}"
                              Classes.hoverable="{Binding GitRef, Converter={x:Static ObjectConverters.IsNotNull}}"
                              Classes.current="{Binding IsCurrentBranch}">
                        <TextBlock Text="{Binding Name}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="cellText" Text="{Binding Subject}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <!-- As DrawArtificialRevision: the counts of the changes of the working directory or the index. -->
                <ItemsControl ItemsSource="{Binding ChangeCounts}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="{Binding ChangesToolTip}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArtificialChangeCount">
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <Image Source="{Binding Icon, Converter={x:Static s:SettingsIconConverter.Instance}}" Width="12" Height="12" VerticalAlignment="Center" />
                        <TextBlock Classes="cellText" Text="{Binding Count}" VerticalAlignment="Center" MinWidth="14" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:RevisionGridRow">
              <TextBlock Classes="cellText" Text="{Binding Notes}" ToolTip.Tip="{Binding NotesToolTip}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="22" CanUserResize="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:RevisionGridRow">
              <Image Name="avatar" Source="{Binding Avatar, Converter={x:Static rg:AvatarConverter.Instance}}" Width="18" Height="18" Margin="2,0" ToolTip.Tip="{Binding AuthorToolTip}"
                     HorizontalAlignment="Left" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:RevisionGridRow">
              <TextBlock Classes="cellText author" Classes.highlighted="{Binding IsAuthorHighlighted}" Text="{Binding AuthorName}" ToolTip.Tip="{Binding AuthorToolTip}"
                         VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="130">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:RevisionGridRow">
              <TextBlock Classes="cellText" Text="{Binding Date}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="80">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:RevisionGridRow">
              <TextBlock Classes="cellText" Text="{Binding ShortId}" FontFamily="{DynamicResource MonospaceFontFamily}" VerticalAlignment="Center" Margin="4,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:RevisionGridRow">
              <!-- As BuildStatusColumnProvider: the symbol and/or the description, colored by the status; a click opens the report. -->
              <StackPanel Name="buildStatus" Orientation="Horizontal" Spacing="2" Margin="2,0" Background="Transparent" ClipToBounds="True"
                          Classes.buildReport="{Binding HasBuildReport}" ToolTip.Tip="{Binding BuildStatusToolTip}">
                <TextBlock Classes="buildStatus" Classes.Success="{Binding BuildStatus.Status, Converter={x:Static rg:BuildStatusClassConverter.Instance}, ConverterParameter=Success, FallbackValue=False}"
                           Classes.Failure="{Binding BuildStatus.Status, Converter={x:Static rg:BuildStatusClassConverter.Instance}, ConverterParameter=Failure, FallbackValue=False}"
                           Classes.InProgress="{Binding BuildStatus.Status, Converter={x:Static rg:BuildStatusClassConverter.Instance}, ConverterParameter=InProgress, FallbackValue=False}"
                           Classes.Unstable="{Binding BuildStatus.Status, Converter={x:Static rg:BuildStatusClassConverter.Instance}, ConverterParameter=Unstable, FallbackValue=False}"
                           Classes.Stopped="{Binding BuildStatus.Status, Converter={x:Static rg:BuildStatusClassConverter.Instance}, ConverterParameter=Stopped, FallbackValue=False}"
                           Text="{Binding BuildStatusSymbol}" VerticalAlignment="Center"
                           IsVisible="{Binding $parent[rg:RevisionGridView].ViewModel.ShowBuildStatusIcon, FallbackValue=True}" />
                <TextBlock Classes="buildStatus" Classes.Success="{Binding BuildStatus.Status, Converter={x:Static rg:BuildStatusClassConverter.Instance}, ConverterParameter=Success, FallbackValue=False}"
                           Classes.Failure="{Binding BuildStatus.Status, Converter={x:Static rg:BuildStatusClassConverter.Instance}, ConverterParameter=Failure, FallbackValue=False}"
                           Classes.InProgress="{Binding BuildStatus.Status, Converter={x:Static rg:BuildStatusClassConverter.Instance}, ConverterParameter=InProgress, FallbackValue=False}"
                           Classes.Unstable="{Binding BuildStatus.Status, Converter={x:Static rg:BuildStatusClassConverter.Instance}, ConverterParameter=Unstable, FallbackValue=False}"
                           Classes.Stopped="{Binding BuildStatus.Status, Converter={x:Static rg:BuildStatusClassConverter.Instance}, ConverterParameter=Stopped, FallbackValue=False}"
                           Text="{Binding BuildStatusDescription}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding $parent[rg:RevisionGridView].ViewModel.ShowBuildStatusText, FallbackValue=False}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <!-- The quick search string, as QuickSearchProvider's label. -->
    <Border Name="quickSearchLabel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1" Padding="7,5,5,5"
            Background="#FFFFE1" IsVisible="{Binding IsQuickSearchVisible}" IsHitTestVisible="False">
      <TextBlock Text="{Binding QuickSearchLabel}" FontWeight="Bold" FontSize="14"
                 Classes.noMatch="{Binding !IsQuickSearchMatched}" />
    </Border>
  </Panel>
</UserControl>

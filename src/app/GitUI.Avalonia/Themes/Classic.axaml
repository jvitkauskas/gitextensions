<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:classic="clr-namespace:Classic.Avalonia.Theme;assembly=Classic.Avalonia.Theme">
  <!-- Keep Classic's bevels and compact templates; use the host palette for interaction states. -->
  <Style Selector="Button:not(:disabled):pointerover">
    <Setter Property="Background" Value="{DynamicResource ThemeControlHighlightLowBrush}" />
  </Style>
  <Style Selector="Button:not(:disabled):pressed">
    <Setter Property="Background" Value="{DynamicResource ThemeControlHighlightMidBrush}" />
  </Style>
  <Style Selector="Button.accent:not(:disabled), Button[IsDefault=True]:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource HighlightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HighlightForegroundBrush}" />
  </Style>
  <Style Selector="Button.accent:not(:disabled):pointerover, Button[IsDefault=True]:not(:disabled):pointerover">
    <Setter Property="Background" Value="{DynamicResource SimpleAccentHoverBrush}" />
  </Style>
  <Style Selector="Button.accent:not(:disabled):pressed, Button[IsDefault=True]:not(:disabled):pressed">
    <Setter Property="Background" Value="{DynamicResource HighlightBrush2}" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush4}" />
  </Style>
  <Style Selector="ToggleButton:checked /template/ classic|ClassicBorderDecorator#ContentContainer">
    <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush3}" />
  </Style>
</Styles>

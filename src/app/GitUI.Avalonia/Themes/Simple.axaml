<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Loaded only with Simple. Keep its compact templates, but distinguish inputs, hover, focus and primary actions. -->
  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource SimpleInputBackgroundBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#border">
    <Setter Property="BorderBrush" Value="{DynamicResource SimpleFocusBrush}" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
  </Style>
  <Style Selector="Button.accent, Button[IsDefault=True]">
    <Setter Property="Background" Value="{DynamicResource HighlightBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HighlightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HighlightForegroundBrush}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button[IsDefault=True]:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SimpleAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SimpleFocusBrush}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter, Button[IsDefault=True]:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HighlightBrush2}" />
  </Style>
  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SimpleFocusBrush}" />
  </Style>
</Styles>

<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <NoWarn>$(NoWarn);VSTHRD003</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Copyright>Copyright &#xA9; hypersw, Maximus5, 2015–2016 // Copyright &#xA9; 2019 Git Extensions</Copyright>
    <Description>The console emulator session of conemu-inside, without WinForms, that embeds a fully functional console view in a native window.</Description>
    <Product>Git Extensions</Product>
    <Company>Git Extensions</Company>
    <Authors>hypersw, Maximus5 // Git Extensions</Authors>
  </PropertyGroup>

</Project>
